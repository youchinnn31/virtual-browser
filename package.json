{
  "name": "virtual-browser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "evaluate:repeat": "npm run build && node evaluation/repeat.mjs",
    "all": "npm-run-all lint build start",
    "build": "npm-run-all clean:* build:* copy",
    "build:client": "node build.client.mjs",
    "build:server": "node build.server.mjs",
    "clean:dist": "rimraf dist",
    "aa:db": "rimraf *.db",
    "copy": "npm-run-all copy:*",
    "copy:client": "cpr --filter=.*\\.ts$ src/client dist/client",
    "fix": "npm-run-all fix:*",
    "fix:prettier": "prettier --write .",
    "lint": "npm-run-all --continue-on-error lint:*",
    "lint:eslint": "eslint src/**/*.ts",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc",
    "start": "node dist/server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^5.0.0",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.5.13",
    "cpr": "^3.0.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "exceljs": "^4.4.0",
    "globals": "^15.11.0",
    "markuplint": "^4.10.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  },
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "lighthouse": "^12.2.2",
    "puppeteer": "^21.11.0",
    "sharp": "^0.33.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.0"
  }
}
