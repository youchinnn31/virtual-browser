{
  "name": "virtual-browser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "all": "npm-run-all lint build start",
    "build": "npm-run-all clean build:* copy",
    "build:client": "node build.client.mjs",
    "build:server": "node build.server.mjs",
    "clean": "rimraf dist",
    "copy": "npm-run-all copy:*",
    "copy:html": "cpr --filter=.*\\.ts$ src/client dist/client",
    "fix": "npm-run-all fix:*",
    "fix:prettier": "prettier --write .",
    "lint": "npm-run-all --continue-on-error lint:*",
    "lint:eslint": "eslint src/**/*.ts",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc",
    "start": "node dist/server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^5.0.0",
    "cpr": "^3.0.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "markuplint": "^4.10.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "express": "^4.21.1",
    "playwright": "^1.48.1",
    "sharp": "^0.33.5"
  }
}
