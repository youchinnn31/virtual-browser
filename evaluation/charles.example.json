{
  "proxyHost": "127.0.0.1",
  "proxyPort": 8888,
  "timeoutMs": 10000,
  "tolerance": 0.2,
  "status": { "method": "GET", "path": "/<確認した状態取得パス>" },
  "enabledPattern": "<有効な状態だけに一致する正規表現>",
  "disabledPattern": "<無効な状態だけに一致する正規表現>",
  "disable": { "method": "POST", "path": "/<確認した無効化パス>" },
  "presets": {
    "128": {
      "select": { "method": "POST", "path": "/<128kbpsの有効化パス>" },
      "selectedPattern": "<128kbps選択時だけに一致する正規表現>"
    },
    "200": {
      "select": { "method": "POST", "path": "/<200kbpsの有効化パス>" },
      "selectedPattern": "<200kbps選択時だけに一致する正規表現>"
    },
    "300": {
      "select": { "method": "POST", "path": "/<300kbpsの有効化パス>" },
      "selectedPattern": "<300kbps選択時だけに一致する正規表現>"
    },
    "1024": {
      "select": { "method": "POST", "path": "/<1024kbpsの有効化パス>" },
      "selectedPattern": "<1024kbps選択時だけに一致する正規表現>"
    }
  }
}
